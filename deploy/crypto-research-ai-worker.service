[Unit]
Description=Crypto Research AI Proposal and Analysis Worker
After=network-online.target crypto-research-telegram.service
Wants=network-online.target

[Service]
Type=simple
User=botadmin
WorkingDirectory=/home/botadmin/crypto-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/botadmin/crypto-bot/venv/bin/python -m bot.automation.ai_worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
